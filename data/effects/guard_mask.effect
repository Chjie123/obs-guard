// guard_mask.effect -- 遮罩合成（单 pass）
// 支持最多 16 个遮罩矩形，三种样式：纯色 / 高斯近似 / 马赛克。
// 坐标一律为帧归一化 UV（0..1，左上原点），矩形由 CPU 侧算好外扩。

uniform float4x4 ViewProj;

uniform texture2d image;

uniform float4 texel;        // (1/w, 1/h, w, h)
uniform float2 pad_uv;       // 额外像素边距换算成 UV
uniform float2 feather_uv;   // 边缘羽化宽度（UV）

uniform float3 mask_color;
uniform float  base_opacity;
uniform float  style;        // 0 纯色 / 1 模糊 / 2 马赛克
uniform float2 blur_uv;
uniform float2 block_uv;

uniform float  count;
uniform float  sec;          // 秒，可用于呼吸/闪烁（保留）

uniform float4 m0; uniform float f0; uniform float s0;
uniform float4 m1; uniform float f1; uniform float s1;
uniform float4 m2; uniform float f2; uniform float s2;
uniform float4 m3; uniform float f3; uniform float s3;
uniform float4 m4; uniform float f4; uniform float s4;
uniform float4 m5; uniform float f5; uniform float s5;
uniform float4 m6; uniform float f6; uniform float s6;
uniform float4 m7; uniform float f7; uniform float s7;
uniform float4 m8; uniform float f8; uniform float s8;
uniform float4 m9; uniform float f9; uniform float s9;
uniform float4 m10; uniform float f10; uniform float s10;
uniform float4 m11; uniform float f11; uniform float s11;
uniform float4 m12; uniform float f12; uniform float s12;
uniform float4 m13; uniform float f13; uniform float s13;
uniform float4 m14; uniform float f14; uniform float s14;
uniform float4 m15; uniform float f15; uniform float s15;
uniform float4 m16; uniform float f16; uniform float s16;
uniform float4 m17; uniform float f17; uniform float s17;
uniform float4 m18; uniform float f18; uniform float s18;
uniform float4 m19; uniform float f19; uniform float s19;
uniform float4 m20; uniform float f20; uniform float s20;
uniform float4 m21; uniform float f21; uniform float s21;
uniform float4 m22; uniform float f22; uniform float s22;
uniform float4 m23; uniform float f23; uniform float s23;
uniform float4 m24; uniform float f24; uniform float s24;
uniform float4 m25; uniform float f25; uniform float s25;
uniform float4 m26; uniform float f26; uniform float s26;
uniform float4 m27; uniform float f27; uniform float s27;
uniform float4 m28; uniform float f28; uniform float s28;
uniform float4 m29; uniform float f29; uniform float s29;
uniform float4 m30; uniform float f30; uniform float s30;
uniform float4 m31; uniform float f31; uniform float s31;

uniform float4 roi_rect;
uniform float  roi_on;
uniform float  box_on;
uniform float  conf_on;

sampler_state linear_sampler {
	AddressU = Clamp;
	AddressV = Clamp;
	Filter   = Linear;
};

struct VertIn {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

struct VertOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertOut VSDefault(VertIn v_in)
{
	VertOut v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv  = v_in.uv;
	return v_out;
}

// 单条遮罩合成
float4 apply_mask(float4 col, float4 r, float fade, float2 uv)
{
	if (fade <= 0.002)
		return col;

	float2 lo = r.xy - pad_uv;
	float2 hi = r.xy + r.zw + pad_uv;

	if (uv.x < lo.x || uv.x > hi.x || uv.y < lo.y || uv.y > hi.y)
		return col;

	float3 c;

	if (style < 0.5) {
		// 纯色：L1 阻断级，绝不使用可被还原的模糊
		c = mask_color;
	} else if (style < 1.5) {
		// 高斯近似：9 抽样，双环加权
		float2 d = blur_uv;
		c  = image.Sample(linear_sampler, uv).rgb * 0.200;
		c += image.Sample(linear_sampler, uv + float2( d.x, 0.0)).rgb * 0.120;
		c += image.Sample(linear_sampler, uv + float2(-d.x, 0.0)).rgb * 0.120;
		c += image.Sample(linear_sampler, uv + float2(0.0,  d.y)).rgb * 0.120;
		c += image.Sample(linear_sampler, uv + float2(0.0, -d.y)).rgb * 0.120;
		c += image.Sample(linear_sampler, uv + float2( d.x,  d.y)).rgb * 0.080;
		c += image.Sample(linear_sampler, uv + float2(-d.x,  d.y)).rgb * 0.080;
		c += image.Sample(linear_sampler, uv + float2( d.x, -d.y)).rgb * 0.080;
		c += image.Sample(linear_sampler, uv + float2(-d.x, -d.y)).rgb * 0.080;
	} else {
		// 马赛克：UV 量化，最省
		float2 q = floor(uv / block_uv) * block_uv + block_uv * 0.5;
		c = image.Sample(linear_sampler, q).rgb;
	}

	float a = saturate(base_opacity * fade);

	// 1px 羽化，避免硬边锯齿；量级远小于外扩，不会泄漏内容
	if (feather_uv.x > 0.0) {
		float2 d2 = min(uv - lo, hi - uv);
		float e = min(d2.x / feather_uv.x, d2.y / feather_uv.y);
		a *= saturate(e);
	}

	return float4(lerp(col.rgb, c, a), col.a);
}

// 画框线（调试 ROI / 命中框）
float4 outline(float4 col, float4 r, float2 uv, float3 tint)
{
	if (r.z <= 0.0001 || r.w <= 0.0001)
		return col;
	if (uv.x < r.x || uv.x > r.x + r.z || uv.y < r.y || uv.y > r.y + r.w)
		return col;

	float2 dmin = min(uv - r.xy, r.xy + r.zw - uv);
	float e = min(dmin.x / texel.x, dmin.y / texel.y);
	if (e > 1.5)
		return col;

	return float4(lerp(col.rgb, tint, 0.9), col.a);
}

// ---------------------------------------------------------------------------
// 置信度读数
//
// OBS 的滤镜面板无法实时刷新文本，数值只能叠加到画面上。这里用一个 7 段
// 数码管画两位数（00..99，即置信度 *100），代价远低于引入字体纹理。
// ---------------------------------------------------------------------------

// 段位掩码：bit0 上 / bit1 右上 / bit2 右下 / bit3 下 / bit4 左下 / bit5 左上 / bit6 中
int digit_segments(int d)
{
	if (d == 0) return 63;
	if (d == 1) return 6;
	if (d == 2) return 91;
	if (d == 3) return 79;
	if (d == 4) return 102;
	if (d == 5) return 109;
	if (d == 6) return 125;
	if (d == 7) return 7;
	if (d == 8) return 127;
	return 111;
}

// q：数字单元格内坐标 0..1；t：笔画粗细（相对单元格）
float digit_alpha(float2 q, int d, float t)
{
	if (q.x < 0.0 || q.x > 1.0 || q.y < 0.0 || q.y > 1.0)
		return 0.0;

	int m = digit_segments(d);
	float a = 0.0;

	if (((m >> 0) & 1) == 1 && q.y < t && q.x > t && q.x < 1.0 - t)
		a = 1.0;
	if (((m >> 6) & 1) == 1 && abs(q.y - 0.5) < t * 0.5 && q.x > t && q.x < 1.0 - t)
		a = 1.0;
	if (((m >> 3) & 1) == 1 && q.y > 1.0 - t && q.x > t && q.x < 1.0 - t)
		a = 1.0;
	if (((m >> 5) & 1) == 1 && q.x < t && q.y > t * 0.8 && q.y < 0.5 - t * 0.4)
		a = 1.0;
	if (((m >> 1) & 1) == 1 && q.x > 1.0 - t && q.y > t * 0.8 && q.y < 0.5 - t * 0.4)
		a = 1.0;
	if (((m >> 4) & 1) == 1 && q.x < t && q.y > 0.5 + t * 0.4 && q.y < 1.0 - t * 0.8)
		a = 1.0;
	if (((m >> 2) & 1) == 1 && q.x > 1.0 - t && q.y > 0.5 + t * 0.4 && q.y < 1.0 - t * 0.8)
		a = 1.0;

	return a;
}

// 在命中框左上角叠加「置信度 *100」的两位读数，越靠左上越不容易被边框挡住
float4 conf_label(float4 col, float4 r, float score, float2 uv)
{
	if (r.z <= 0.0001 || r.w <= 0.0001)
		return col;

	float cell_h = 18.0 * texel.y;
	float cell_w = 11.0 * texel.x;
	float gap = 3.0 * texel.x;
	float padx = 4.0 * texel.x;
	float total_w = cell_w * 2.0 + gap + padx * 2.0;

	float2 o;
	o.x = clamp(r.x, 0.0, max(0.0, 1.0 - total_w));
	o.y = r.y - cell_h - 3.0 * texel.y;
	if (o.y < 0.0)
		o.y = r.y + 3.0 * texel.y;

	if (uv.x >= o.x && uv.x <= o.x + total_w && uv.y >= o.y && uv.y <= o.y + cell_h)
		col.rgb = lerp(col.rgb, float3(0.0, 0.0, 0.0), 0.45);

	int v = min(99, (int)floor(saturate(score) * 100.0 + 0.5));
	int d0 = (int)floor((float)v * 0.1); // 用浮点乘避免整数除法（逐像素执行）
	int d1 = v - d0 * 10;

	float2 q;
	q.x = (uv.x - o.x - padx) / cell_w;
	q.y = (uv.y - o.y) / cell_h;

	float a = digit_alpha(q, d0, 0.19);
	q.x -= 1.0 + gap / cell_w;
	a = max(a, digit_alpha(q, d1, 0.19));

	if (a > 0.0)
		col.rgb = lerp(col.rgb, float3(1.0, 1.0, 1.0), a);

	return col;
}

float4 PSBase(VertIn v_in) : TARGET
{
	float2 uv = v_in.uv;
	float4 col = image.Sample(linear_sampler, uv);

	if (count > 0.5) col = apply_mask(col, m0, f0, uv);
	if (count > 1.5) col = apply_mask(col, m1, f1, uv);
	if (count > 2.5) col = apply_mask(col, m2, f2, uv);
	if (count > 3.5) col = apply_mask(col, m3, f3, uv);
	if (count > 4.5) col = apply_mask(col, m4, f4, uv);
	if (count > 5.5) col = apply_mask(col, m5, f5, uv);
	if (count > 6.5) col = apply_mask(col, m6, f6, uv);
	if (count > 7.5) col = apply_mask(col, m7, f7, uv);
	if (count > 8.5) col = apply_mask(col, m8, f8, uv);
	if (count > 9.5) col = apply_mask(col, m9, f9, uv);
	if (count > 10.5) col = apply_mask(col, m10, f10, uv);
	if (count > 11.5) col = apply_mask(col, m11, f11, uv);
	if (count > 12.5) col = apply_mask(col, m12, f12, uv);
	if (count > 13.5) col = apply_mask(col, m13, f13, uv);
	if (count > 14.5) col = apply_mask(col, m14, f14, uv);
	if (count > 15.5) col = apply_mask(col, m15, f15, uv);
	if (count > 16.5) col = apply_mask(col, m16, f16, uv);
	if (count > 17.5) col = apply_mask(col, m17, f17, uv);
	if (count > 18.5) col = apply_mask(col, m18, f18, uv);
	if (count > 19.5) col = apply_mask(col, m19, f19, uv);
	if (count > 20.5) col = apply_mask(col, m20, f20, uv);
	if (count > 21.5) col = apply_mask(col, m21, f21, uv);
	if (count > 22.5) col = apply_mask(col, m22, f22, uv);
	if (count > 23.5) col = apply_mask(col, m23, f23, uv);
	if (count > 24.5) col = apply_mask(col, m24, f24, uv);
	if (count > 25.5) col = apply_mask(col, m25, f25, uv);
	if (count > 26.5) col = apply_mask(col, m26, f26, uv);
	if (count > 27.5) col = apply_mask(col, m27, f27, uv);
	if (count > 28.5) col = apply_mask(col, m28, f28, uv);
	if (count > 29.5) col = apply_mask(col, m29, f29, uv);
	if (count > 30.5) col = apply_mask(col, m30, f30, uv);
	if (count > 31.5) col = apply_mask(col, m31, f31, uv);

	if (box_on > 0.5) {
		float3 tint = float3(0.15, 1.0, 0.35);
		if (count > 0.5) col = outline(col, m0, uv, tint);
		if (count > 1.5) col = outline(col, m1, uv, tint);
		if (count > 2.5) col = outline(col, m2, uv, tint);
		if (count > 3.5) col = outline(col, m3, uv, tint);
		if (count > 4.5) col = outline(col, m4, uv, tint);
		if (count > 5.5) col = outline(col, m5, uv, tint);
		if (count > 6.5) col = outline(col, m6, uv, tint);
		if (count > 7.5) col = outline(col, m7, uv, tint);
		if (count > 8.5) col = outline(col, m8, uv, tint);
		if (count > 9.5) col = outline(col, m9, uv, tint);
		if (count > 10.5) col = outline(col, m10, uv, tint);
		if (count > 11.5) col = outline(col, m11, uv, tint);
		if (count > 12.5) col = outline(col, m12, uv, tint);
		if (count > 13.5) col = outline(col, m13, uv, tint);
		if (count > 14.5) col = outline(col, m14, uv, tint);
		if (count > 15.5) col = outline(col, m15, uv, tint);
		if (count > 16.5) col = outline(col, m16, uv, tint);
		if (count > 17.5) col = outline(col, m17, uv, tint);
		if (count > 18.5) col = outline(col, m18, uv, tint);
		if (count > 19.5) col = outline(col, m19, uv, tint);
		if (count > 20.5) col = outline(col, m20, uv, tint);
		if (count > 21.5) col = outline(col, m21, uv, tint);
		if (count > 22.5) col = outline(col, m22, uv, tint);
		if (count > 23.5) col = outline(col, m23, uv, tint);
		if (count > 24.5) col = outline(col, m24, uv, tint);
		if (count > 25.5) col = outline(col, m25, uv, tint);
		if (count > 26.5) col = outline(col, m26, uv, tint);
		if (count > 27.5) col = outline(col, m27, uv, tint);
		if (count > 28.5) col = outline(col, m28, uv, tint);
		if (count > 29.5) col = outline(col, m29, uv, tint);
		if (count > 30.5) col = outline(col, m30, uv, tint);
		if (count > 31.5) col = outline(col, m31, uv, tint);
	}

	if (conf_on > 0.5) {
		if (count > 0.5) col = conf_label(col, m0, s0, uv);
		if (count > 1.5) col = conf_label(col, m1, s1, uv);
		if (count > 2.5) col = conf_label(col, m2, s2, uv);
		if (count > 3.5) col = conf_label(col, m3, s3, uv);
		if (count > 4.5) col = conf_label(col, m4, s4, uv);
		if (count > 5.5) col = conf_label(col, m5, s5, uv);
		if (count > 6.5) col = conf_label(col, m6, s6, uv);
		if (count > 7.5) col = conf_label(col, m7, s7, uv);
		if (count > 8.5) col = conf_label(col, m8, s8, uv);
		if (count > 9.5) col = conf_label(col, m9, s9, uv);
		if (count > 10.5) col = conf_label(col, m10, s10, uv);
		if (count > 11.5) col = conf_label(col, m11, s11, uv);
		if (count > 12.5) col = conf_label(col, m12, s12, uv);
		if (count > 13.5) col = conf_label(col, m13, s13, uv);
		if (count > 14.5) col = conf_label(col, m14, s14, uv);
		if (count > 15.5) col = conf_label(col, m15, s15, uv);
		if (count > 16.5) col = conf_label(col, m16, s16, uv);
		if (count > 17.5) col = conf_label(col, m17, s17, uv);
		if (count > 18.5) col = conf_label(col, m18, s18, uv);
		if (count > 19.5) col = conf_label(col, m19, s19, uv);
		if (count > 20.5) col = conf_label(col, m20, s20, uv);
		if (count > 21.5) col = conf_label(col, m21, s21, uv);
		if (count > 22.5) col = conf_label(col, m22, s22, uv);
		if (count > 23.5) col = conf_label(col, m23, s23, uv);
		if (count > 24.5) col = conf_label(col, m24, s24, uv);
		if (count > 25.5) col = conf_label(col, m25, s25, uv);
		if (count > 26.5) col = conf_label(col, m26, s26, uv);
		if (count > 27.5) col = conf_label(col, m27, s27, uv);
		if (count > 28.5) col = conf_label(col, m28, s28, uv);
		if (count > 29.5) col = conf_label(col, m29, s29, uv);
		if (count > 30.5) col = conf_label(col, m30, s30, uv);
		if (count > 31.5) col = conf_label(col, m31, s31, uv);
	}

	if (roi_on > 0.5)
		col = outline(col, roi_rect, uv, float3(1.0, 0.15, 0.85));

	return col;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSBase(v_in);
	}
}
