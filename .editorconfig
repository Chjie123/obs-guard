root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{c,cc,cpp,h,hpp}]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,ini,txt,py}]
indent_style = space
indent_size = 2

[*.{ps1,cmd}]
indent_style = space
indent_size = 4
end_of_line = crlf
